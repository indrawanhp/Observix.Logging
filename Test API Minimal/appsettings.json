{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "None",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "None",
      "Microsoft.AspNetCore.Diagnostics": "None"
    }
  },
  "AllowedHosts": "*",
  "AppInfo": {
    "FullName": "test-api-minimal"
  },
  "Observix": {
    "Provider": "Serilog",
    "EnableConsole": false,
    "EnableFile": true,
    "EnvironmentName": "Development",
    "MaxBodyLength": 5000,
    "File": {
      "BasePath": "C:\\deployment",
      "Template": "{AppName}/logs/app/{LogFolder}/{Year-Month}/{Day}/Log_{Country}_.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "Shared": true
    }
  }
}
